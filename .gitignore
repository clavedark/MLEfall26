# R / RStudio state
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Quarto cache / freeze
/.quarto/
/_freeze/
*_cache/
*_files/

# OS
.DS_Store

# Data files — provided to students through Brightspace, not the public repo.
# populate-data.sh remains tracked so Dave / a TA / a future machine can re-fetch.
data/*
!data/.gitkeep
!data/README.md
# Deliberate exception (2026-08-12): ITT.csv IS published in the repo and linked
# from the code page, with a source credit. ITT is openly distributed data; the
# covariates are WDI + Polity (both open). This is the one tracked data file.
!data/ITT.csv

# Reading PDFs — copyrighted journal articles; kept locally, not in the public repo.
# Students get readings through Brightspace. See refs606.bib for the citations.
readings/*
!readings/.gitkeep

# ---------------------------------------------------------------------------
# PUBLISH ONLY THE SITE SHELL + SYLLABUS.
# Topic decks, exercises, and scratch stay on disk (rendered, for reference)
# but are held out of the public repo until released.
# To RELEASE a deck: add matching `!<deck>.qmd` and `!docs/<deck>.html` lines
# in the un-ignore blocks below, render it, link it in slides.qmd, then commit.
# ---------------------------------------------------------------------------

# Sources: ignore every .qmd, then re-include only the published pages.
*.qmd
!index.qmd
!about.qmd
!slides.qmd
!code.qmd
!mlesyllabus26.qmd
# released deck: linear model prediction methods
!predictionOLS26.qmd
# released deck: binary response models
!binarymodels26.qmd

# Rendered output: ignore everything under docs/, then re-include only the
# published pages and the shared assets GitHub Pages needs to serve them.
docs/*
!docs/index.html
!docs/about.html
!docs/slides.html
!docs/code.html
!docs/mlesyllabus26.html
!docs/mlesyllabus26.pdf
# released deck: linear model prediction methods
!docs/predictionOLS26.html
# released deck: binary response models
!docs/binarymodels26.html
!docs/styles.css
# Aggregate of EVERY page rendered into docs/, not just the published ones,
# so it leaks unreleased decks and answer keys unless trimmed. Run
# ./prune-search-index.sh after each render, before committing.
!docs/search.json
!docs/site_libs/
# ...but NOT these generated libs: decks embed their own resources
# (embed-resources: true), and no served shell page references them, so they are
# render byproducts, not site assets. Ignoring them keeps them out of commits.
docs/site_libs/kePrint/
docs/site_libs/lightable/
docs/site_libs/revealjs/
# Same story for the htmlwidgets/plotly stack pulled in by interactive figures
# (versioned dir names, so match by prefix).
docs/site_libs/crosstalk*/
docs/site_libs/htmltools-fill*/
docs/site_libs/htmlwidgets*/
docs/site_libs/jquery*/
docs/site_libs/plotly-*/
docs/site_libs/typedarray*/
!docs/.nojekyll

# Assignment-development projects (not part of the course site)
flock-mle-assignment/
flock-placement/

# Loose scratch / deck assets at the repo root
Rplots.pdf
sandbox26.R
snoop.jpeg
zorntweet.png

# PLSC 501 materials parked here — they belong to the 501 course, not this site.
# Answer keys stay out of the public repo regardless.
Coding Challenges Sp 2026.pptx
challenge*-wage1-key.R

# Claude Code local project config
.claude/

# Project worklog — names unreleased decks and answer keys; this repo is public.
worklog.md
